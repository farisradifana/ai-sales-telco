# TELCO Sales AI — contoh konfigurasi. TIDAK berisi secret. Isi nilai asli lewat secret manager / deploy/.env.staging.
# Generate nilai acak lokal: python scripts/dev_secrets.py .local/dev.env

# --- PostgreSQL bisnis (migrator/owner hanya untuk job migrate/load) ---
POSTGRES_OWNER_PASSWORD=
DATABASE_URL=postgresql://telco_owner:CHANGE_ME@localhost:5432/telco   # hanya untuk python -m telco.db (migrate/load/validate)
# LOGIN role least-privilege (dibuat oleh: python -m telco_api.provision roles)
TELCO_API_READER_PASSWORD=
TELCO_API_WRITER_PASSWORD=
TELCO_API_IDENTITY_PASSWORD=
TELCO_OPS_PASSWORD=
READER_DATABASE_URL=postgresql://telco_api_reader:CHANGE_ME@db:5432/telco?sslmode=verify-full
WRITER_DATABASE_URL=postgresql://telco_api_writer:CHANGE_ME@db:5432/telco?sslmode=verify-full
IDENTITY_DATABASE_URL=postgresql://telco_api_identity:CHANGE_ME@db:5432/telco?sslmode=verify-full
OPS_DATABASE_URL=postgresql://telco_ops_login:CHANGE_ME@db:5432/telco?sslmode=verify-full
STATEMENT_TIMEOUT_MS=15000
LOCK_TIMEOUT_MS=3000

# --- Aplikasi / auth ---
APP_ENV=staging                 # local|test|staging|production (dev-login hanya local/test)
JWT_SECRET=                     # HS256 untuk IdP shim staging; produksi pakai JWT_JWKS_URL dari IdP perusahaan
JWT_JWKS_URL=
JWT_ISSUER=telco-sales-ai
JWT_AUDIENCE=telco-api
PUBLIC_BASE_URL=https://REPLACE_PUBLIC_HOSTNAME
PUBLIC_HOSTNAME=REPLACE_PUBLIC_HOSTNAME

# --- Service-to-service ---
N8N_SERVICE_TOKEN=
MCP_SERVICE_TOKEN=              # MCP bridge -> API
MCP_BRIDGE_TOKEN=               # Hermes -> MCP bridge
N8N_DISPATCH_SECRET=            # API -> n8n webhook (header token + HMAC)

# --- WhatsApp Cloud API resmi (Meta) ---
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0
WA_SEND_MODE=disabled           # disabled|mock|live. live WAJIB WA_LIVE_ALLOWLIST_HMACS (blind index penerima uji yang disetujui)
WA_LIVE_ALLOWLIST_HMACS=

# --- PII mapping (base64 32 byte masing-masing) ---
IDENTITY_ENC_KEY=
IDENTITY_HMAC_KEY=
CHART_SIGNING_KEY=

# --- Hermes Agent 0.20.5 (@14c59f0) dan 9Router 0.5.99 ---
HERMES_BASE_URL=http://hermes:8642
HERMES_API_KEY=
HERMES_ALLOWED_TOOLSETS=        # kosong = tidak ada toolset bawaan Hermes yang boleh aktif
ROUTER_BASE_URL=http://router:20128
ROUTER_API_KEY=
MODEL_ID=                       # ID model dari provider berizin yang dikonfigurasi di 9Router (jangan menebak)
FALLBACK_MODEL_ID=
AGENT_TIMEOUT_S=45

# --- n8n (queue mode) ---
N8N_ENCRYPTION_KEY=             # sama persis di main, webhook, worker
N8N_DB_PASSWORD=
REDIS_PASSWORD=
GSHEET_RECAP_SPREADSHEET_ID=1XAlDtkIA5gkdodi-fZip5x7Lbyri-YRk4dRJLOHPwRg
