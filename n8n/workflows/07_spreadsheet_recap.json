      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Metadata lines (# key: value) become a header block; data rows are kept as exported (no recalculation).\nconst text = $('Export CSV').first().json.csv || '';\nconst lines = text.split('\\n').filter(l => l.length);\nconst meta = lines.filter(l => l.startsWith('# ')).map(l => { const i = l.indexOf(': '); return { kolom_a: l.slice(2, i), kolom_b: l.slice(i + 2) }; });\nconst data = lines.filter(l => !l.startsWith('# '));\nconst header = data.shift().split(',');\nconst rows = data.map(l => { const v = l.split(','); return Object.fromEntries(header.map((h, i) => [h, v[i] ?? ''])); });\nreturn [...meta.map(m => ({ json: { day_wib: '#' + m.kolom_a, outlet_code: m.kolom_b } })), ...rows.map(r => ({ json: r }))];"
      }
