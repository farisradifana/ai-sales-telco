      "position": [
        300,
        110
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "p",
              "name": "provider",
              "type": "string",
              "value": "={{ $json.body.provider }}"
            },
            {
              "id": "m",
              "name": "message_id",
              "type": "string",
              "value": "={{ $json.body.message_id }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "router-2",
      "name": "Claim",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        110
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "telcoApiService",
          "name": "TELCO API service token"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "http://api:8000/internal/v1/events/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ provider: $('Event').first().json.provider, message_id: $('Event').first().json.message_id }) }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "id": "router-3",
      "name": "Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        110
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "claimed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
